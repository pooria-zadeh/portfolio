{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "node scripts/serve-static.mjs --dir out --port 3100",
    "start": "node scripts/serve-static.mjs --dir out --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:pins": "node scripts/check-pins.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:quick": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:responsive": "playwright test tests/e2e/responsive.spec.ts",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "check": "npm run lint && npm run typecheck && npm run check:pins && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "framer-motion": "13.1.1",
    "lenis": "1.3.26",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
